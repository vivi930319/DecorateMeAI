<mxfile host="app.diagrams.net">
  <diagram name="會員升級方案流程圖" id="membership-flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Section titles -->
        <mxCell id="title-a" value="每日打卡集點" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title-b" value="推廣集點" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="0" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title-c" value="集點換主題" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="1120" y="0" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title-d" value="付費解鎖 PRO / 無限次數" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="1660" y="0" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- Section A: 每日打卡集點 -->
        <mxCell id="a1" value="會員登入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="今天打卡了嗎？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="按下打卡按鈕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="+10 點，記錄今日已打卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="按鈕顯示「今日已打卡」，不可再按" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="260" y="250" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-a1-a2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a2-a3" value="沒有" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a3-a4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a2-a5" value="已打卡" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Section B: 推廣集點 -->
        <mxCell id="b1" value="會員 A 在個人頁看到自己的推薦碼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="分享給朋友 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="B 註冊時填入 A 的推薦碼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="系統記一筆「待審核推廣申請」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="管理員在後台看到申請清單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="核對推薦碼，找到 A 了嗎？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="管理員按下核發，A +50 點" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="管理員忽略／退回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e-b1-b2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b2-b3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b3-b4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b4-b5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b5-b6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b6-b7" value="找到" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b6-b8" value="找不到/有疑慮" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Section C: 集點換主題 -->
        <mxCell id="c1" value="會員在個人頁看到主題選單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="點數夠嗎？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="按下兌換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="240" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="扣點數，解鎖該主題" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1120" y="330" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="可自由切換已解鎖的主題" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1120" y="420" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="顯示還差多少點" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1380" y="240" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e-c1-c2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c2-c3" value="夠" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c3-c4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c4-c5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c2-c6" value="不夠" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Section D: 付費解鎖 PRO / 無限次數 -->
        <mxCell id="d1" value="會員在個人頁按「申請升級 VIP」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1660" y="40" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="記一筆待審核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1660" y="130" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="管理員在後台看到「申請升級中」標記" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1660" y="220" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="管理員把等級改成 VIP 並存檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1660" y="310" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="自動解鎖 PRO 分析 + 無限渲染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1660" y="400" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e-d1-d2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d2-d3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d3-d4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d4-d5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
