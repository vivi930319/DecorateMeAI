# Base image 連 digest 一起釘住。只寫 `python:3.11-slim` 的話，同一份 Dockerfile
# 今天與下個月會build出不同的東西——上游 tag 是會被覆寫的。要升級就換 digest，
# 那是一次看得見、進得了 code review 的變更。
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.gateway.txt .
RUN pip install --no-cache-dir -r requirements.gateway.txt

COPY dev_server_utils.py .
COPY api_errors.py .
COPY admin_audit.py .
COPY job_store.py .
COPY ai_gateway.py .

# 非 root 執行。容器被打進來時，root 讓攻擊者可以裝套件、改系統檔、寫任意路徑；
# 這個帳號連 /app 都只有讀取權（檔案是 root 擁有、複製進來就不再需要被寫）。
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser
USER 10001

EXPOSE 8080

CMD ["uvicorn", "ai_gateway:app", "--host", "0.0.0.0", "--port", "8080"]
