# Copy to .env and replace every CHANGE_ME value locally or in the deployment
# secret manager. Do not commit actual credentials to this file.
FLASK_DEBUG=false
PORT=5000
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

# PostgreSQL database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=decorate_me

# Storefront display conversion for official USD product links
USD_TO_TWD_RATE=32
USD_TO_TWD_RATE_AS_OF=YYYY-MM-DD

# Redis and OTP policy
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OTP_EXPIRE_SECONDS=600
OTP_SEND_WINDOW_SECONDS=3600
OTP_SEND_MAX_ATTEMPTS=5
PENDING_REGISTRATION_EXPIRE_SECONDS=900

# Service-to-service authentication
UPSTREAM_MEMBER_API_KEY=CHANGE_ME
GATEWAY_KEY_LOOSE_MODE=false

# Product preview crawler
CRAWLER_CONNECT_TIMEOUT=5
CRAWLER_READ_TIMEOUT=10
CRAWLER_MAX_HTML_BYTES=2000000
CRAWLER_MAX_REDIRECTS=3
CRAWLER_RATE_WINDOW_SECONDS=60
CRAWLER_ADMIN_RATE_LIMIT=30
CRAWLER_DOMAIN_RATE_LIMIT=20
CRAWLER_GLOBAL_RATE_LIMIT=100
