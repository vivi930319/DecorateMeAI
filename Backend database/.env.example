# Flask
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=change-me

# PostgreSQL database
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/app
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=app

# Storefront display conversion for official USD product links
USD_TO_TWD_RATE=31.685
USD_TO_TWD_RATE_AS_OF=2026-08-30T09:25:00+08:00

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OTP_EXPIRE_SECONDS=300
OTP_SEND_WINDOW_SECONDS=900
OTP_SEND_MAX_ATTEMPTS=5
PENDING_REGISTRATION_EXPIRE_SECONDS=1800
UPSTREAM_MEMBER_API_KEY=replace-with-a-long-random-value
GATEWAY_KEY_LOOSE_MODE=true

# Product preview crawler
CRAWLER_CONNECT_TIMEOUT=5
CRAWLER_READ_TIMEOUT=10
CRAWLER_MAX_HTML_BYTES=2097152
CRAWLER_MAX_REDIRECTS=3
CRAWLER_RATE_WINDOW_SECONDS=600
CRAWLER_ADMIN_RATE_LIMIT=10
CRAWLER_DOMAIN_RATE_LIMIT=30
CRAWLER_GLOBAL_RATE_LIMIT=100
