# Flask
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-me-in-production

# PostgreSQL used by docker-compose.yml
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=empower_beauty

# Storefront display conversion for official USD product links
USD_TO_TWD_RATE=31.685
USD_TO_TWD_RATE_AS_OF=2026-08-30T09:25:00+08:00

# Port 5432 is occupied by the archived Windows PostgreSQL instance. Keep the
# canonical Docker database on 5433 so every active API uses the same store.
DB_PORT_PUBLISHED=5433
REDIS_PORT_PUBLISHED=6379

# OTP / Email
OTP_EXPIRE_SECONDS=300
OTP_SEND_WINDOW_SECONDS=900
OTP_SEND_MAX_ATTEMPTS=5
PENDING_REGISTRATION_EXPIRE_SECONDS=1800
UPSTREAM_MEMBER_API_KEY=replace-with-a-long-random-value
GATEWAY_KEY_LOOSE_MODE=true
SMTP_USER=
SMTP_PASS=

# Optional AI services
OLLAMA_HOST=
SD_HOST=
