        </mxCell>
        <mxCell id="6" value="BASIC模式&#10;&#10;適用對象：一般使用者／訪客&#10;照片需求：一張清楚正面照&#10;分析內容：正面五官、膚色與輪廓&#10;用途：快速分析及妝容推薦" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="175" width="350" height="360" as="geometry" />
        </mxCell>
        <mxCell id="7" value="PRO模式&#10;&#10;適用對象：VIP會員&#10;照片需求：正面照＋側面輔助照&#10;分析內容：完整BASIC結果＋雙角度膚色輔助&#10;限制：側面深度特徵仍為未來擴充" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1">
