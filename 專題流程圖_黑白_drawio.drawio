<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="整組系統 API 流程" id="whole-api">
    <mxGraphModel dx="1200" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title-api" value="整組系統 API 流程&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Whole-system API Flow&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Georgia;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="62" as="geometry"/></mxCell>
        <mxCell id="note-api" value="瀏覽器只呼叫同源 Gateway；上游金鑰與內部服務不放在前端" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1120" height="24" as="geometry"/></mxCell>

        <mxCell id="api-client-zone" value="使用者端" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="210" height="190" as="geometry"/></mxCell>
        <mxCell id="api-browser" value="Browser SPA&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Firebase Hosting&lt;/font&gt;&lt;br&gt;&lt;br&gt;上傳照片／查看結果&lt;br&gt;建議／渲染／推薦" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="160" height="105" as="geometry"/></mxCell>

        <mxCell id="api-boundary-zone" value="信任邊界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="125" width="265" height="330" as="geometry"/></mxCell>
        <mxCell id="api-gateway" value="AI Gateway&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ai_gateway.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;HttpOnly Session／角色&lt;br&gt;CSRF／Origin／actor&lt;br&gt;路由白名單／逾時／錯誤正規化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="190" width="205" height="190" as="geometry"/></mxCell>

        <mxCell id="api-service-zone" value="後端服務" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="125" width="560" height="330" as="geometry"/></mxCell>
        <mxCell id="api-face" value="Face BASIC／PRO&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MediaPipe／ROI／ONNX&lt;br&gt;同步分析或建立 job&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="175" width="235" height="90" as="geometry"/></mxCell>
        <mxCell id="api-text" value="文字建議&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ollama／Gemma 3&lt;br&gt;分析結果 → 結構化建議&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="235" height="90" as="geometry"/></mxCell>
        <mxCell id="api-render" value="妝容渲染服務&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Replicate&lt;br&gt;建立／查詢 render job&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="315" width="235" height="90" as="geometry"/></mxCell>
        <mxCell id="api-member" value="會員／商品服務&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;會員、商品、收藏&lt;br&gt;推薦與色差比對&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="315" width="235" height="90" as="geometry"/></mxCell>

        <mxCell id="api-store-zone" value="資料與媒體" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="490" width="875" height="140" as="geometry"/></mxCell>
        <mxCell id="api-firestore" value="Firestore Job Store&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;analysisPackage／job／回饋／狀態&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="535" width="235" height="62" as="geometry"/></mxCell>
        <mxCell id="api-gcs" value="Private GCS&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;渲染結果／貢獻影像／模型 bundle&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="535" width="235" height="62" as="geometry"/></mxCell>
        <mxCell id="api-db" value="會員／商品資料庫&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;會員、商品、收藏資料&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="535" width="195" height="62" as="geometry"/></mxCell>

        <mxCell id="api-e1" value="同源 HTTPS／JSON／multipart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-browser" target="api-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e2" value="POST analyze／GET job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-gateway" target="api-face"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e3" value="POST advice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-gateway" target="api-text"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e4" value="POST／GET render job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-gateway" target="api-render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e5" value="members／products／saved-looks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-gateway" target="api-member"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e6" value="工作狀態／分析包" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-face" target="api-firestore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e7" value="job／媒體" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-render" target="api-gcs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e8" value="狀態／索引" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-render" target="api-firestore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="api-e9" value="資料存取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="api-member" target="api-db"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="後台資料流程" id="backend-admin">
    <mxGraphModel dx="1200" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title-admin" value="後台資料流程&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Backend Admin Flow&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Georgia;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="62" as="geometry"/></mxCell>
        <mxCell id="note-admin" value="後台只登記決定；訓練與升版由本機 Worker 執行" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1120" height="24" as="geometry"/></mxCell>

        <mxCell id="adm-console-zone" value="管理端" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="260" as="geometry"/></mxCell>
        <mxCell id="adm-console" value="Admin Console&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;管理員 Session／角色&lt;br&gt;會員與商品覆核&lt;br&gt;送訓／升版決策&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="160" height="115" as="geometry"/></mxCell>

        <mxCell id="adm-gateway-zone" value="API 邊界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="270" height="430" as="geometry"/></mxCell>
        <mxCell id="adm-gateway" value="AI Gateway&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/admin-api/*&lt;br&gt;Session／admin role&lt;br&gt;CSRF double-submit&lt;br&gt;actor／owner／allowlist&lt;br&gt;錯誤與稽核&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="225" width="210" height="190" as="geometry"/></mxCell>

        <mxCell id="adm-data-zone" value="資料與佇列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="250" height="430" as="geometry"/></mxCell>
        <mxCell id="adm-db" value="會員／商品資料庫&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;會員、商品、收藏&lt;br&gt;Gateway 代理存取&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="185" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="adm-queue" value="Firestore 佇列&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;face_feedback&lt;br&gt;training_runs／promotions&lt;br&gt;deployments／render_jobs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="adm-gcs" value="Private GCS&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;貢獻影像／模型 bundle&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="485" width="190" height="62" as="geometry"/></mxCell>

        <mxCell id="adm-worker-zone" value="本機執行端" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="260" height="430" as="geometry"/></mxCell>
        <mxCell id="adm-worker" value="training_worker&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;輪詢 queued job&lt;br&gt;下載核准資料&lt;br&gt;identity split／holdout&lt;br&gt;訓練與評估&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="205" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="adm-promotion" value="promotion_worker&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;檢查 metrics／manifest&lt;br&gt;換檔／上傳／部署&lt;br&gt;smoke 驗證／rollback&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="385" width="200" height="120" as="geometry"/></mxCell>

        <mxCell id="adm-e1" value="登入／管理 API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-console" target="adm-gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e2" value="members／products" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-gateway" target="adm-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e3" value="覆核／送訓／升版" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-gateway" target="adm-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e4" value="輪詢 queued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-worker" target="adm-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e5" value="貢獻影像／模型檔" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-worker" target="adm-gcs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e6" value="訓練結果／metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-worker" target="adm-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e7" value="promote／deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-queue" target="adm-promotion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e8" value="ONNX／manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-promotion" target="adm-gcs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-e9" value="版本狀態／smoke 結果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;fontSize=10;" edge="1" parent="1" source="adm-promotion" target="adm-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adm-footer" value="訓練完成 ≠ 自動上線；升版必須經 promotion、部署、smoke 驗證，失敗可 rollback。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1120" height="40" as="geometry"/></mxCell>
