  <diagram name="Admin Flow" id="admin-flow">
    <mxGraphModel dx="1100" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="後台管理流程" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="login" value="管理員登入&#10;(role = admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cookie" value="種下 session cookie&#10;(SameSite=None; Secure; HttpOnly)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="members" value="GET /api/members&#10;讀取會員清單（僅 admin）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="224" width="240" height="52" as="geometry" />
        </mxCell>

        <mxCell id="looks" value="逐會員&#10;GET .../saved-looks&#10;收藏數（即時檢視）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="180" height="66" as="geometry" />
        </mxCell>
        <mxCell id="points" value="逐會員&#10;GET .../points&#10;點數（即時檢視）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="245" y="330" width="170" height="66" as="geometry" />
        </mxCell>
        <mxCell id="patchM" value="PATCH /api/members/{email}&#10;改角色 / 等級 / 停權 / 權限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="POST / PATCH /api/products&#10;商品 CRUD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="330" width="200" height="66" as="geometry" />
        </mxCell>

        <mxCell id="relogin" value="任何請求遇 401（session 過期）→ 自動用暫存帳密重登 → 重試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="300" height="44" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;" edge="1" parent="1" source="login" target="cookie"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;" edge="1" parent="1" source="cookie" target="members"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="即時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="members" target="looks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;" edge="1" parent="1" source="members" target="points"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="編輯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="members" target="patchM"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#000000;" edge="1" parent="1" source="members" target="prod"><mxGeometry relative="1" as="geometry" /></mxCell>
