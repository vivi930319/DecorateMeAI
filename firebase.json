{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "**/*.bak*",
      "**/*.log",
      "**/*.docx",
      "**/*.pdf",
      "**/*.pptx",
      "**/*.drawio",
      "**/*.py",
      "docs/**",
      "deploy.ps1",
      "frontend_smoke_check.js",
      "config.local.example.js",
      "img.png",
      "img_1.png",
      "img_2.png",
      "img_3.png"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
